# ============================================================
# PEDIDOS TRINIDAD — Variables de Entorno
# Copia este archivo a .env y completa los valores reales
# NUNCA subas .env a GitHub (está en .gitignore)
# ============================================================

# ── BASE DE DATOS ─────────────────────────────────────────
# Local (PostgreSQL):
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/pedidostrinidad?schema=public"
#
# Neon (Producción en Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/pedidostrinidad?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedidostrinidad?schema=public"

# ── NEXTAUTH ───────────────────────────────────────────────
# En desarrollo: http://localhost:3000
# En Vercel: https://tu-app.vercel.app  (sin barra al final)
NEXTAUTH_URL="http://localhost:3000"

# Genera un secret seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRET_SEGURO"

# ── GOOGLE OAUTH ───────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com
# 2. Crea un proyecto → APIs & Services → Credentials
# 3. OAuth 2.0 Client ID (tipo: Web Application)
# 4. Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google  (desarrollo)
#    - https://tu-app.vercel.app/api/auth/callback/google  (producción)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── CLOUDINARY ─────────────────────────────────────────────
# 1. Crea cuenta en https://cloudinary.com (plan gratuito disponible)
# 2. Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Upload preset sin firma (para subidas desde el frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="pedidos_trinidad_unsigned"

# ── WEB PUSH (VAPID) ───────────────────────────────────────
# Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="admin@pedidostrinidad.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
